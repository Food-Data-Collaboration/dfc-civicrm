  <!-- Persons — dfc-ldp.yaml: /persons/{personId}/index                    -->
  <!--                                                                       -->
  <!-- NO /persons CONTAINER EXISTS. The spec states: "Persons sit outside    -->
  <!-- any organization: they are addressed from the platform". Our previous -->
  <!-- /persons container was invented and has been removed.                 -->
  <!-- ==================================================================== -->

  <item>
    <path>civicrm/dfc/v2/persons</path>
    <title>DFC Person</title>
    <desc>A single DFC Person (contract path /persons/{personId}/index, GET/PUT/PATCH/DELETE). Identify the person with the "personId" query argument. Backing record is a native CiviCRM Contact with contact_type=Individual. Persons sit outside any Organization and have no container of their own in the contract.</desc>
    <page_callback>Civi\Dfc\Http\Page\PersonResource</page_callback>
    <page_arguments>dfc_shape={personId}/index</page_arguments>

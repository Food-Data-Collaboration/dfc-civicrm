{
    "name": "zoro-jiro-san/dfc-civicrm",
    "description": "Native CiviCRM extension exposing the DFC v2 JSON-LD HTTP interface",
    "type": "civicrm-extension",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": ">=8.1",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Civi\\Dfc\\": "Civi/Dfc/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Civi\\Dfc\\Test\\": "tests/phpunit/"
        }
    },
    "scripts": {
        "test": "phpunit --testsuite unit",
        "test:conformance": "phpunit --testsuite conformance"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "civicrm": {
            "extensionSkeleton": "civicrm-extension"
        }
    }
}